{
  "agent_name": "AI Academic Research Paper Agent",
  "version": "2.5.0",
  "engine": "gemini-3.8-flash",
  "framework": {
    "frontend": "React 19 + TypeScript + Tailwind CSS",
    "backend": "Node.js + Express 4",
    "ai_sdk": "@google/genai"
  },
  "capabilities": {
    "topic_decomposition": true,
    "grounded_web_search": true,
    "literature_review_matrix": true,
    "comparative_study_analysis": true,
    "structured_paper_generation": true,
    "anti_hallucination_protocols": {
      "no_fabricated_authors": true,
      "strict_verification_flags": true,
      "hypothetical_results_disclosure": true,
      "unverified_warning_banner": true
    },
    "citation_formats": ["APA 7th Edition", "IEEE", "MLA 9th Edition", "BibTeX"],
    "export_formats": ["TXT", "Markdown (.md)", "JSON", "Formatted Academic Print/PDF"]
  },
  "paper_sections": [
    "1. Title",
    "2. Abstract",
    "3. Keywords",
    "4. Introduction",
    "5. Problem Statement",
    "6. Literature Review",
    "7. Research Objectives",
    "8. Methodology",
    "9. Results and Discussion (with mandatory hypothetical/experimental disclosure)",
    "10. Conclusion",
    "11. Future Scope",
    "12. References"
  ],
  "academic_fields": [
    "Computer Science & Artificial Intelligence",
    "Medicine, Health Sciences & Bioengineering",
    "Environmental Science & Sustainable Technology",
    "Economics, Finance & Management",
    "Social Sciences & Cognitive Psychology",
    "Physics, Materials Science & Quantum Engineering",
    "Education & Educational Technology"
  ],
  "hyperparameters": {
    "thinking_level": "medium",
    "grounding_tool": "googleSearch",
    "strict_grounding_citations": true
  }
}
